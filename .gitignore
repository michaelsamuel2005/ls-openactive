# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Environment / secrets — never commit these
.env
*.key

# Data — raw and processed data is never committed (esp. partner data)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Misc
*.log
.cache/
data/
.claude/
